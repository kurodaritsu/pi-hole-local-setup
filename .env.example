# IANA timezone for log timestamps, e.g. America/New_York, Asia/Singapore.
# List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=

# Web UI admin password. Leave blank and Pi-hole generates a random one on
# first start (check with `docker compose logs pihole`).
# You can also generate one yourself with:
#   openssl rand -base64 24
#   pwgen -s 24 1
ADMIN_PASSWORD=
